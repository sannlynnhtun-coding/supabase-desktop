<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>Supabase Desktop</Product>
    <Title>Supabase Desktop</Title>
    <ApplicationIcon>../Shared/Branding/supabase.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
