<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.2.0</Version>
  </PropertyGroup>
  <ItemGroup><Compile Include="../Shared/RuntimeLinks.cs" Link="RuntimeLinks.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/WindowsInstallation.cs" Link="WindowsInstallation.cs" /></ItemGroup>
  <ItemGroup Condition="Exists('$(PayloadPath)')">
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="SupabaseLocal.Payload.zip" />
  </ItemGroup>

</Project>
